sequenceDiagram
    autonumber
    participant T as execute_test_cases task
    participant L as TestCaseLoader/DB
    participant M as MidsceneAdapter
    participant D as Dispatcher.execute
    participant MR as MasterRouter.route
    participant LP as LeftPupilEngine(APIExecutor)
    participant RUN as Midscene Runner
    participant TARGET as Target Web/API
    participant EX as ExecutionService
    participant DB as DB

    T->>L: load tc_ir

    alt UI or HYBRID tc_ir
        T->>M: execute(tc_ir, initial_context)
        M->>RUN: run visual UI steps
        RUN->>TARGET: browser actions and assertions
        RUN-->>M: traces, screenshots, step status
        M-->>T: normalized case result
    else API-only tc_ir
        T->>D: execute(tc_ir, execution_id, context)
        loop for each API step in tc_ir.steps
            D->>MR: route(step_dict)
            MR-->>D: LEFT_PUPIL
            D->>LP: execute(api_ir, context)
            LP->>TARGET: HTTP request
            TARGET-->>LP: HTTP response
            LP-->>D: API result with assertions/extract/error
        end
        D-->>T: normalized case result
    end

    T->>EX: create_step_result(...)
    EX->>DB: insert ExecutionStep
    T->>EX: update_execution_status(final)
    EX->>DB: update Execution
