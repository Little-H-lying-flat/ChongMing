APP_ENV=dev
DEBUG=false
# 閲嶆槑 (ChongMing) 鐜鍙橀噺閰嶇疆
# 澶嶅埗姝ゆ枃浠朵负 .env 骞跺～鍐欏疄闄呭€?
# ==================== 鐗堟湰鎺у埗 ====================
VERSION=2.0.0

# ==================== 鏁版嵁搴?====================
DB_PASSWORD=chongming123

# ==================== AI 鏈嶅姟 ====================
# 闃块噷浜?DashScope API Key (蹇呭～)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 鏃ュ織绾у埆 ====================
LOG_LEVEL=INFO

# ==================== 鐩戞帶鏈嶅姟瀵嗙爜 ====================
FLOWER_USER=admin
FLOWER_PASSWORD=admin123
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ==================== 鍙€夛細澶栭儴鏈嶅姟 ====================
# LangSmith 杩借釜 (鍙€?
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key

# GitHub Token (鐢ㄤ簬 PR 鑷姩鍒涘缓锛屽彲閫?
# GITHUB_TOKEN=your_github_token

# ==================== 鐢熶骇鐜閰嶇疆 ====================
# 鍙栨秷娉ㄩ噴浠ヤ笅閰嶇疆鐢ㄤ簬鐢熶骇鐜
# REDIS_PASSWORD=your_redis_password
# MILVUS_USER=root
# MILVUS_PASSWORD=your_milvus_password
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Celery runtime (set explicitly in staging/prod)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=db+sqlite:///./celery_results.db
CELERY_TASK_ALWAYS_EAGER=false


