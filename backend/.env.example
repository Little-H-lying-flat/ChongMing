# Backend runtime environment
APP_ENV=dev
DEBUG=false

# Service
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Database
DATABASE_URL=sqlite+aiosqlite:///%LOCALAPPDATA%/ChongMing/chongming.db

# Redis/Celery (dev default: eager=true)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=true

# AI provider
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:18080/v1
VISUAL_UI_DRAFT_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_BASE_URL=http://127.0.0.1:8045/v1

# Midscene Runner
MIDSCENE_RUNNER_URL=http://127.0.0.1:8787
MIDSCENE_TIMEOUT_SECONDS=120
MIDSCENE_DRY_RUN=1
MIDSCENE_MODEL_NAME=qwen-vl-max-latest
MIDSCENE_MODEL_FAMILY=qwen2.5-vl
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional
OMNIPARSER_ENABLED=false
OMNIPARSER_URL=http://localhost:7861
LOG_LEVEL=INFO
